# ==============================================================================
# Environment Configuration for Delto-3F Dexterous Manipulation
# Copy to '.env' and adjust variables for your local hardware / simulation setup
# ==============================================================================

# Hardware Camera Configuration (for ArUco Teleoperation)
CAMERA_INDEX=1
MARKER_LENGTH_METERS=0.015
CAMERA_FPS=60

# Physical Control & Actuator Settings
DELTO_PORT=/dev/ttyUSB0
DELTO_BAUDRATE=1000000
ACTION_SMOOTH_ALPHA=0.50

# Simulation & Parallel Processing Defaults
NUM_BENCHMARK_WORKERS=16
MUJOCO_GL=egl
